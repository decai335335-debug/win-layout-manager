{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🖥️ 一键分配全部窗口",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/snap_all.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "📱 仅测试竖屏",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/snap_vertical_test.py"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "🐢 分步调试模式",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/snap_all.py",
                "--step"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ]
