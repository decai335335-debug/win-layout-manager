{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🖥️ Snap All (一键分配全部窗口)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/snap_all.py",
            "console": "internalConsole",
            "justMyCode": true,
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "📱 Snap Vertical Only (仅竖屏)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/snap_vertical_test.py",
            "console": "internalConsole",
            "justMyCode": true,
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "🐢 Snap All — Step by Step (分步调试)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/snap_all.py",
            "args": ["--step"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONIOENCODING": "utf-8"
            }
        }
    ]
}
